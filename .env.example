# Copiá este archivo como .env y pegá tu llave real.
# NUNCA subas .env a GitHub.
# La sacás de platform.deepseek.com → API keys.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx

# Opcional. Modelo de DeepSeek. Por defecto deepseek-v4-pro.
# Si las generaciones se pasan del limite de tiempo, usar deepseek-v4-flash.
DEEPSEEK_MODEL=
