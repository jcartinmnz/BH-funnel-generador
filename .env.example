# Copiá este archivo como .env y pegá tu llave real.
# NUNCA subas .env a GitHub.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxx

# Solo si tu API key esta ligada a identidad: Anthropic exige saber en que
# workspace actua cada request. Si la key es normal, deja esto vacio.
# El id sale en la URL del workspace en console.anthropic.com (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
